# Variáveis do Container Docker PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appcenter
POSTGRES_PORT=5433

# Conexão do Prisma com o PostgreSQL do Docker
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/appcenter?schema=public"

# Segredo para assinatura de sessão JWT
JWT_SECRET="app-center-pwa-super-secret-jwt-key-2026-fioreapps"

# Porta da aplicação Next.js
PORT=3009
